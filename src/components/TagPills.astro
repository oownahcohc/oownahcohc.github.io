---
interface Props {
	tags: { name: string; count: number }[];
	total: number;
}

const { tags, total } = Astro.props;
---

<div class="tag-pills" data-tag-filter>
	<button class="tag-pill is-active" type="button" data-tag="">전체 <small>{total}</small></button>
	{
		tags.map((tag) => (
			<button class="tag-pill" type="button" data-tag={tag.name}>
				{tag.name} <small>{tag.count}</small>
			</button>
		))
	}
</div>

<script>
	const group = document.querySelector<HTMLElement>('[data-tag-filter]');
	const grid = document.querySelector<HTMLElement>('[data-post-grid]');
	const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

	if (group && grid) {
		const cards = [...grid.querySelectorAll<HTMLElement>('.post-card')];

		group.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.tag-pill');
			if (!button) return;

			const selected = button.dataset.tag ?? '';
			group
				.querySelectorAll('.tag-pill')
				.forEach((pill) => pill.classList.toggle('is-active', pill === button));

			let shown = 0;
			for (const card of cards) {
				const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
				const match = !selected || tags.includes(selected);
				card.hidden = !match;
				if (match) shown++;
			}
			if (empty) empty.hidden = shown > 0;
		});
	}
</script>
