---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/blog">글</HeaderLink>
			<HeaderLink href="/about">소개</HeaderLink>
			<a href="/rss.xml">RSS</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub 프로필">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 0.9em 1em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.site-title {
		font-weight: 700;
		font-size: 1.05em;
		color: var(--fg-strong);
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.1em;
		font-size: 0.9em;
	}
	.links a {
		display: flex;
		align-items: center;
		color: var(--fg-muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
	@media (max-width: 520px) {
		.links {
			gap: 0.85em;
			font-size: 0.85em;
		}
	}
</style>
