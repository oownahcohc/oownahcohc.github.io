---
import { Image } from 'astro:assets';
import CoverArt from './CoverArt.astro';
import FormattedDate from './FormattedDate.astro';
import { SERIES } from '../consts';
import { readingTime, type Post } from '../lib/posts';

interface Props {
	post: Post;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags, draft, series } = post.data;
const minutes = readingTime(post.body);
---

<article
	class:list={['post-card', { 'post-card-featured': featured }]}
	data-tags={tags.join(',')}
>
	<a class="post-card-link" href={`/blog/${post.id}/`}>
		<div class="post-card-cover">
			{
				heroImage ? (
					<Image class="post-cover-image" src={heroImage} width={720} height={405} alt="" />
				) : (
					<CoverArt seed={post.id} />
				)
			}
		</div>
		<div class="post-card-body">
			<div class="post-meta">
				{tags[0] && <span>{tags[0]}</span>}
				<span><FormattedDate date={pubDate} /></span>
				<span>{minutes}분 읽기</span>
				{series && <span>{SERIES[series.id]?.title ?? series.id} {series.order}편</span>}
				{draft && <span>초안</span>}
			</div>
			<h2>{title}</h2>
			<p>{description}</p>
			{
				tags.length > 0 && (
					<div class="post-card-tags">
						{tags.map((tag) => (
							<span>{tag}</span>
						))}
					</div>
				)
			}
		</div>
	</a>
</article>
