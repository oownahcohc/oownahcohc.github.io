---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	pubDate: Date;
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], headings = [] } = Astro.props;

// h2만 목차로 뽑습니다. 2개 이상일 때만 표시.
const toc = headings.filter((h) => h.depth === 2);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-header">
					<p class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									(<FormattedDate date={updatedDate} /> 수정)
								</span>
							)
						}
					</p>
					<h1>{title}</h1>
					{
						tags.length > 0 && (
							<p class="tags">
								{tags.map((tag) => (
									<span class="tag">#{tag}</span>
								))}
							</p>
						)
					}
				</header>

				{
					heroImage && (
						<figure class="hero">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</figure>
					)
				}

				{
					toc.length > 1 && (
						<nav class="toc" aria-label="목차">
							<p class="toc-title">목차</p>
							<ul>
								{toc.map((h) => (
									<li>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>

			<p class="back"><a href="/blog">← 목록으로</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5em;
	}
	.post-header h1 {
		margin: 0.2em 0 0;
	}
	.date {
		margin: 0;
		font-size: 0.85em;
		color: var(--fg-muted);
	}
	.updated {
		font-style: italic;
	}
	.tags {
		margin: 0.9em 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		font-size: 0.8em;
	}
	.tag {
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.1em 0.6em;
		border-radius: 999px;
	}
	.hero {
		margin: 0 0 2.5em;
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		box-shadow: var(--box-shadow);
	}
	.toc {
		background: var(--bg-subtle);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1em 1.4em;
		margin-bottom: 2.5em;
		font-size: 0.9em;
	}
	.toc-title {
		margin: 0 0 0.4em;
		font-weight: 700;
		color: var(--fg-strong);
		font-size: 0.9em;
	}
	.toc ul {
		margin: 0;
		padding-left: 1.1em;
	}
	.toc li {
		margin-bottom: 0.2em;
	}
	.toc a {
		text-decoration: none;
		color: var(--fg-muted);
	}
	.toc a:hover {
		color: var(--accent);
	}
	.prose :global(h2),
	.prose :global(h3) {
		scroll-margin-top: 5rem;
	}
	.back {
		margin-top: 4em;
		padding-top: 2em;
		border-top: 1px solid var(--border);
		font-size: 0.9em;
	}
	.back a {
		text-decoration: none;
	}
</style>
