---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { readingTime, type Post } from '../lib/posts';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	pubDate: Date;
	headings?: MarkdownHeading[];
	minutes?: number;
	related?: Post[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	headings = [],
	minutes,
	related = [],
} = Astro.props;

// h2, h3만 목차로 씁니다.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="article-page">
			<header class="article-header">
				<div class="article-meta">
					{tags[0] && <span>{tags[0]}</span>}
					<span><FormattedDate date={pubDate} /></span>
					{minutes && <span>{minutes}분 읽기</span>}
					{updatedDate && <span><FormattedDate date={updatedDate} /> 수정</span>}
				</div>
				<h1>{title}</h1>
				<p>{description}</p>
				{
					tags.length > 0 && (
						<div class="article-tags">
							{tags.map((tag) => (
								<span class="article-tag">{tag}</span>
							))}
						</div>
					)
				}
			</header>

			{
				heroImage && (
					<div class="article-cover">
						<Image src={heroImage} width={1280} height={720} alt="" />
					</div>
				)
			}

			<div class="article-shell">
				<article class="article-content">
					<slot />
				</article>

				{
					toc.length > 1 && (
						<aside class:list={['article-toc', { 'is-compact': toc.length > 8 }]} aria-label="목차">
							<strong>목차</strong>
							<nav>
								{toc.map((h) => (
									<a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-depth-3' : ''}>
										{h.text}
									</a>
								))}
							</nav>
						</aside>
					)
				}
			</div>

			{
				related.length > 0 && (
					<section class="related-section">
						<div class="section-heading">
							<p class="eyebrow">Related</p>
							<h2>함께 읽어보기</h2>
						</div>
						<div class="related-list">
							{related.map((post) => (
								<a class="related-link" href={`/blog/${post.id}/`}>
									<span>{post.data.tags[0] ?? '글'}</span>
									<strong>{post.data.title}</strong>
									<small>{readingTime(post.body)}분</small>
								</a>
							))}
						</div>
					</section>
				)
			}
		</main>
		<Footer />

		<script>
			// 스크롤 위치에 따라 목차 항목을 강조합니다.
			const links = [...document.querySelectorAll<HTMLAnchorElement>('.article-toc a')];
			if (links.length > 0) {
				// 한글·숫자로 시작하는 id는 CSS 선택자로 못 쓰므로 getElementById를 씁니다.
				const idOf = (link: HTMLAnchorElement) => decodeURIComponent(link.hash).slice(1);
				const targets = links
					.map((link) => document.getElementById(idOf(link)))
					.filter((el): el is HTMLElement => el !== null);

				const setActive = (id: string) => {
					for (const link of links) {
						link.classList.toggle('is-active', idOf(link) === id);
					}
				};

				const observer = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((entry) => entry.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
						if (visible) setActive(visible.target.id);
					},
					{ rootMargin: '-96px 0px -70% 0px', threshold: 0 },
				);

				for (const target of targets) observer.observe(target);
			}
		</script>
	</body>
</html>
