---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import TagPills from '../components/TagPills.astro';
import {
	HERO_BODY,
	HERO_EYEBROW,
	HERO_HEADLINE,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';
import { collectTags, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const [featured] = posts;
const tags = collectTags(posts);
const headlineLines = HERO_HEADLINE.split('\n');
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="home-hero">
				<div class="hero-copy">
					<p class="eyebrow">{HERO_EYEBROW}</p>
					<h1>
						{headlineLines.map((line, i) => (
							<>
								{i > 0 && <br />}
								{line}
							</>
						))}
					</h1>
					<p>{HERO_BODY}</p>
					<a class="hero-link" href="/blog">글 둘러보기</a>
				</div>
				{
					featured && (
						<div class="hero-feature">
							<PostCard post={featured} featured />
						</div>
					)
				}
			</section>

			<section class="posts-section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Latest Articles</p>
						<h2>최신 글</h2>
					</div>
					{tags.length > 0 && <TagPills tags={tags} total={posts.length} />}
				</div>

				{
					posts.length === 0 ? (
						<p class="empty-state">
							아직 글이 없습니다. <code>src/content/blog/</code> 에 마크다운 파일을 추가해 보세요.
						</p>
					) : (
						<>
							<div class="post-grid" data-post-grid>
								{posts.map((post) => (
									<PostCard post={post} />
								))}
							</div>
							<p class="empty-state" data-filter-empty hidden>
								해당 태그의 글이 없습니다.
							</p>
						</>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
