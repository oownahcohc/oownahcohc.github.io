---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>안녕하세요 👋</h1>
				<p>
					{SITE_DESCRIPTION} 주로 읽고 만들면서 겪은 문제와 그 해결 과정을 남깁니다.
				</p>
			</section>

			<section class="recent">
				<h2>최근 글</h2>
				{
					posts.length === 0 ? (
						<p class="empty">
							아직 글이 없습니다. <code>src/content/blog/</code> 에 마크다운 파일을 추가해 보세요.
						</p>
					) : (
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span class="title">{post.data.title}</span>
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</a>
									<p class="desc">{post.data.description}</p>
								</li>
							))}
						</ul>
					)
				}
				<p class="more"><a href="/blog">전체 글 보기 →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		padding-bottom: 1em;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5em;
	}
	.intro h1 {
		margin-top: 0;
	}
	.recent h2 {
		font-size: 1.1em;
		color: var(--fg-muted);
		font-weight: 600;
		margin-top: 0;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	li {
		padding: 1.1em 0;
		border-bottom: 1px solid var(--border);
		margin: 0;
	}
	li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		text-decoration: none;
		color: var(--fg-strong);
	}
	.title {
		font-weight: 600;
	}
	li a:hover .title {
		color: var(--accent);
	}
	.date {
		flex-shrink: 0;
		font-size: 0.8em;
		color: var(--fg-muted);
		font-variant-numeric: tabular-nums;
	}
	.desc {
		margin: 0.3em 0 0;
		font-size: 0.9em;
		color: var(--fg-muted);
	}
	.more {
		margin-top: 1.6em;
		font-size: 0.9em;
	}
	.more a {
		text-decoration: none;
	}
	.empty {
		color: var(--fg-muted);
	}
	@media (max-width: 520px) {
		li a {
			flex-direction: column;
			gap: 0.2em;
		}
	}
</style>
