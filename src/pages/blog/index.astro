---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();

// 연도별로 묶어서 보여줍니다.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`글 · ${SITE_TITLE}`} description="지금까지 쓴 글 목록입니다." />
	</head>
	<body>
		<Header />
		<main>
			<h1>글</h1>
			<p class="count">총 {posts.length}개</p>

			{
				years.map((year) => (
					<section class="year-group">
						<h2>{year}</h2>
						<ul>
							{byYear.get(year)!.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span class="title">
											{post.data.title}
											{post.data.draft && <span class="draft">초안</span>}
										</span>
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</a>
									<p class="desc">{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<p class="tags">
											{post.data.tags.map((tag) => (
												<span class="tag">#{tag}</span>
											))}
										</p>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-top: 0;
	}
	.count {
		color: var(--fg-muted);
		font-size: 0.9em;
		margin-bottom: 2.5em;
	}
	.year-group h2 {
		font-size: 0.95em;
		color: var(--fg-muted);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		margin-bottom: 0.2em;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0 0 2.5em;
	}
	li {
		padding: 1.1em 0;
		border-bottom: 1px solid var(--border);
		margin: 0;
	}
	li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		text-decoration: none;
		color: var(--fg-strong);
	}
	.title {
		font-weight: 600;
	}
	li a:hover .title {
		color: var(--accent);
	}
	.draft {
		margin-left: 0.5em;
		font-size: 0.7em;
		font-weight: 500;
		padding: 0.1em 0.5em;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--fg-muted);
		vertical-align: middle;
	}
	.date {
		flex-shrink: 0;
		font-size: 0.8em;
		color: var(--fg-muted);
		font-variant-numeric: tabular-nums;
	}
	.desc {
		margin: 0.3em 0 0;
		font-size: 0.9em;
		color: var(--fg-muted);
	}
	.tags {
		margin: 0.5em 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		font-size: 0.8em;
	}
	.tag {
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.1em 0.6em;
		border-radius: 999px;
	}
	@media (max-width: 520px) {
		li a {
			flex-direction: column;
			gap: 0.2em;
		}
	}
</style>
