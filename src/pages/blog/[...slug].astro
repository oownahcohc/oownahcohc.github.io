---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPosts, readingTime, relatedPosts, seriesOf } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, all: posts },
	}));
}

type Props = { post: CollectionEntry<'blog'>; all: CollectionEntry<'blog'>[] };

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost
	{...post.data}
	headings={headings}
	minutes={readingTime(post.body)}
	related={relatedPosts(post, all)}
	seriesInfo={seriesOf(post, all)}
>
	<Content />
</BlogPost>
